cah:TimeSpan a owl:Class ;
    rdfs:label "TimeSpan" ;
    rdfs:comment "A temporal extent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty cah:startDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty cah:endDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        crm:E52_Time-Span .

