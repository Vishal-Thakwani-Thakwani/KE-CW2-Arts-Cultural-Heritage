    rdfs:comment "A style or movement in art history." ;
    rdfs:subClassOf crm:E55_Type ;
    owl:disjointWith cah:Artist .

cah:Collector a owl:Class ;
    rdfs:label "Collector" ;
    rdfs:comment "A person or entity collecting artworks." ;
    rdfs:subClassOf crm:E39_Actor .

cah:Curator a owl:Class ;
    rdfs:label "Curator" ;
    rdfs:comment "A person organizing exhibitions." ;
    rdfs:subClassOf crm:E21_Person .

cah:Museum a owl:Class ;
    rdfs:label "Museum" ;
    rdfs:comment "An institution that holds or exhibits artworks." ;
    rdfs:subClassOf crm:E40_Legal_Body ;
    owl:disjointWith cah:Artist .

cah:Prize a owl:Class ;
    rdfs:label "Prize" ;
    rdfs:comment "An award given for artistic achievement." ;
    rdfs:subClassOf crm:E89_Propositional_Object .

cah:RestorationEvent a owl:Class ;
    rdfs:label "RestorationEvent" ;
    rdfs:comment "An event of conservation/restoration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cah:hasTimeSpan ;
            owl:someValuesFrom cah:TimeSpan ],
        crm:E11_Modification .

