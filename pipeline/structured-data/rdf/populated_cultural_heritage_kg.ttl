ch:timespan_92385 a ch:TimeSpan ;
    ch:endDate "1899"^^xsd:gYear ;
    ch:startDate "1850"^^xsd:gYear .

ch:timespan_92387 a ch:TimeSpan ;
    ch:endDate "1987"^^xsd:gYear ;
    ch:startDate "1900"^^xsd:gYear .

ch:timespan_98472 a ch:TimeSpan ;
    ch:endDate "2000"^^xsd:gYear ;
    ch:startDate "1975"^^xsd:gYear .

cah:ArtPeriod a owl:Class ;
    rdfs:label "ArtPeriod" ;
    rdfs:comment "A historical period classification." ;
    rdfs:subClassOf crm:E4_Period ;
    owl:disjointWith cah:Artwork .

cah:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A geopolitical entity." ;
    rdfs:subClassOf crm:E53_Place .

cah:DonationEvent a owl:Class ;
    rdfs:label "DonationEvent" ;
    rdfs:comment "A transfer of ownership as a donation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cah:donatedTo ;
            owl:someValuesFrom cah:Museum ],
        [ a owl:Restriction ;
            owl:onProperty cah:donatedBy ;
            owl:someValuesFrom cah:Collector ],
        cah:ProvenanceEvent .

cah:Genre a owl:Class ;
    rdfs:label "Genre" ;
    rdfs:comment "A category of artistic composition." ;
    rdfs:subClassOf crm:E55_Type .

cah:belongsToMovement a owl:ObjectProperty ;
    rdfs:label "belongsToMovement" ;
    rdfs:comment "Relates an artwork to an art movement." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:ArtMovement .

cah:donatedBy a owl:ObjectProperty ;
    rdfs:label "donatedBy" ;
    rdfs:comment "Relates an artwork to the donor." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Collector .

cah:donatedTo a owl:ObjectProperty ;
    rdfs:label "donatedTo" ;
    rdfs:comment "Relates a donation event to a museum." ;
    rdfs:domain cah:DonationEvent ;
    rdfs:range cah:Museum .

cah:endDate a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:comment "The end date of a time span." ;
    rdfs:domain cah:TimeSpan ;
    rdfs:range xsd:date .

cah:hasOwner a owl:ObjectProperty ;
    rdfs:label "hasOwner" ;
    rdfs:comment "Relates an artwork to its owner." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Institution .

cah:hasParticipant a owl:ObjectProperty ;
    rdfs:label "hasParticipant" ;
    rdfs:comment "Relates an exhibition to participating artworks or artists." ;
    rdfs:domain cah:Exhibition ;
    rdfs:range crm:E39_Actor .

cah:hasTimeSpan a owl:ObjectProperty ;
    rdfs:label "hasTimeSpan" ;
    rdfs:comment "Relates an event to its time span." ;
    rdfs:domain crm:E2_Temporal_Entity ;
    rdfs:range cah:TimeSpan ;
    rdfs:subPropertyOf crm:P4_has_time-span .

cah:heldBy a owl:ObjectProperty ;
    rdfs:label "heldBy" ;
    rdfs:comment "Relates an artwork to the institution that holds it." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Institution ;
    rdfs:subPropertyOf crm:P50_has_current_keeper ;
    owl:inverseOf cah:inverse_heldBy .

cah:inverse_influencedBy a owl:ObjectProperty ;
    rdfs:label "inverse_influencedBy" ;
    rdfs:comment "Inverse of influencedBy (influenced)." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:inverse_participatedInExhibition a owl:ObjectProperty ;
    rdfs:label "inverse_participatedInExhibition" ;
    rdfs:comment "Inverse of participatedInExhibition." ;
    rdfs:domain cah:Exhibition ;
    rdfs:range cah:Artwork .

cah:inverse_underwentRestoration a owl:ObjectProperty ;
    rdfs:label "inverse_underwentRestoration" ;
    rdfs:comment "Inverse of underwentRestoration." ;
    rdfs:domain cah:RestorationEvent ;
    rdfs:range cah:Artwork .

cah:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "locatedIn" ;
    rdfs:comment "Relates an institution to a place." ;
    rdfs:domain cah:Institution ;
    rdfs:range crm:E53_Place ;
    rdfs:subPropertyOf crm:P53_has_former_or_current_location ;
    owl:propertyChainAxiom ( cah:heldBy cah:locatedIn ) .

cah:organizedBy a owl:ObjectProperty ;
    rdfs:label "organizedBy" ;
    rdfs:comment "Relates an exhibition to a curator." ;
    rdfs:domain cah:Exhibition ;
    rdfs:range cah:Curator .

cah:startDate a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    rdfs:comment "The start date of a time span." ;
    rdfs:domain cah:TimeSpan ;
    rdfs:range xsd:date .

cah:transferredOwnershipFrom a owl:ObjectProperty ;
    rdfs:label "transferredOwnershipFrom" ;
    rdfs:comment "Relates a provenance event to the previous owner." ;
    rdfs:domain cah:ProvenanceEvent ;
    rdfs:range cah:Institution .

cah:transferredOwnershipTo a owl:ObjectProperty ;
    rdfs:label "transferredOwnershipTo" ;
    rdfs:comment "Relates a provenance event to the new owner." ;
    rdfs:domain cah:ProvenanceEvent ;
    rdfs:range cah:Institution ;
    owl:inverseOf cah:transferredOwnershipFrom .

cah:usesMedium a owl:ObjectProperty ;
    rdfs:label "usesMedium" ;
    rdfs:comment "Relates an artwork to the medium used." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Medium .

ch:artist_1079 a ch:Artist ;
    rdfs:label "Christian Gobrecht" .

ch:artist_108029 a ch:Artist ;
    rdfs:label "Follower of Lippo Memmi (Filippo di Memmo)" .

ch:artist_161869 a ch:Artist ;
    rdfs:label "Walker Evans" .

ch:artist_20217 a ch:Artist ;
    rdfs:label "Romeo Gigli" .

ch:medium_Bamboo a ch:Medium ;
    rdfs:label "Bamboo" .

ch:medium_Cloisonn%C3%A9_enamel%2C_silver_gilt a ch:Medium ;
    rdfs:label "Cloisonné enamel, silver gilt" .

ch:medium_Copper_alloy a ch:Medium ;
    rdfs:label "Copper alloy" .

ch:medium_Gelatin_silver_print a ch:Medium ;
    rdfs:label "Gelatin silver print" .

ch:medium_Oil_on_paper%2C_laid_down_on_canvas a ch:Medium ;
    rdfs:label "Oil on paper, laid down on canvas" .

ch:medium_Photo_silkscreen a ch:Medium ;
    rdfs:label "Photo silkscreen" .

ch:medium_Silk a ch:Medium ;
    rdfs:label "Silk" .

ch:medium_Wood a ch:Medium ;
    rdfs:label "Wood" .

ch:period_Cypro-Geometric_I a ch:ArtPeriod ;
    rdfs:label "Cypro-Geometric I" .

ch:period_Late_Period%E2%80%93Ptolemaic_Period a ch:ArtPeriod ;
    rdfs:label "Late Period–Ptolemaic Period" .

cah:ArtMovement a owl:Class ;
    rdfs:label "ArtMovement" ;
    rdfs:comment "A style or movement in art history." ;
    rdfs:subClassOf crm:E55_Type ;
    owl:disjointWith cah:Artist .

cah:Collector a owl:Class ;
    rdfs:label "Collector" ;
    rdfs:comment "A person or entity collecting artworks." ;
    rdfs:subClassOf crm:E39_Actor .

cah:Curator a owl:Class ;
    rdfs:label "Curator" ;
    rdfs:comment "A person organizing exhibitions." ;
    rdfs:subClassOf crm:E21_Person .

cah:Medium a owl:Class ;
    rdfs:label "Medium" ;
    rdfs:comment "The material or technique used in an artwork." ;
    rdfs:subClassOf crm:E57_Material .

cah:Museum a owl:Class ;
    rdfs:label "Museum" ;
    rdfs:comment "An institution that holds or exhibits artworks." ;
    rdfs:subClassOf crm:E40_Legal_Body ;
    owl:disjointWith cah:Artist .

cah:Prize a owl:Class ;
    rdfs:label "Prize" ;
    rdfs:comment "An award given for artistic achievement." ;
    rdfs:subClassOf crm:E89_Propositional_Object .

cah:RestorationEvent a owl:Class ;
    rdfs:label "RestorationEvent" ;
    rdfs:comment "An event of conservation/restoration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cah:hasTimeSpan ;
            owl:someValuesFrom cah:TimeSpan ],
        crm:E11_Modification .

cah:createdBy a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:comment "Relates an artwork to the artist who created it." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Artist ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    owl:inverseOf cah:inverse_createdBy .

cah:hasContributor a owl:ObjectProperty ;
    rdfs:label "hasContributor" ;
    rdfs:comment "Relates an artwork to multiple contributing artists." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Artist .

cah:inverse_heldBy a owl:ObjectProperty ;
    rdfs:label "inverse_heldBy" ;
    rdfs:comment "Inverse of heldBy (institution to artworks held)." ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:Artwork .

ch:artist_164633 a ch:Artist ;
    rdfs:label "Scott Hyde" .

ch:artist_165380 a ch:Artist ;
    rdfs:label "Frank Waller" .

ch:country_India a ch:Country ;
    rdfs:label "India" .

ch:country_Japan a ch:Country ;
    rdfs:label "Japan" .

ch:medium_Oil_on_canvas a ch:Medium ;
    rdfs:label "Oil on canvas" .

ch:medium_Tempera_on_wood%2C_gold_ground a ch:Medium ;
    rdfs:label "Tempera on wood, gold ground" .

ch:medium_Woodblock_print%3B_ink_and_color_on_paper a ch:Medium ;
    rdfs:label "Woodblock print; ink and color on paper" .

cah:ProvenanceEvent a owl:Class ;
    rdfs:label "ProvenanceEvent" ;
    rdfs:comment "An ownership transfer event." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Institution ;
            owl:onProperty cah:transferredOwnershipTo ],
        crm:E10_Transfer_of_Custody .

cah:inverse_createdBy a owl:ObjectProperty ;
    rdfs:label "inverse_createdBy" ;
    rdfs:comment "Inverse of createdBy (artist to artworks created)." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artwork .

ch:artist_164560 a ch:Artist ;
    rdfs:label "Katsushika Hokusai" .

ch:period_Neo-Babylonian a ch:ArtPeriod ;
    rdfs:label "Neo-Babylonian" .

cah:TimeSpan a owl:Class ;
    rdfs:label "TimeSpan" ;
    rdfs:comment "A temporal extent." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty cah:startDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:date ;
            owl:onProperty cah:endDate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        crm:E52_Time-Span .

ch:artist_162280 a ch:Artist ;
    rdfs:label "Pierre Puvis de Chavannes" .

ch:country_Egypt a ch:Country ;
    rdfs:label "Egypt" .

ch:medium_Clay a ch:Medium ;
    rdfs:label "Clay" .

ch:medium_Gold a ch:Medium ;
    rdfs:label "Gold" .

ch:medium_Illustrated_book a ch:Medium ;
    rdfs:label "Illustrated book" .

ch:medium_Terracotta a ch:Medium ;
    rdfs:label "Terracotta" .

ch:period_Edo_period_%281615%E2%80%931868%29 a ch:ArtPeriod ;
    rdfs:label "Edo period (1615–1868)" .

cah:Exhibition a owl:Class ;
    rdfs:label "Exhibition" ;
    rdfs:comment "An event where artworks are displayed." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artwork ;
            owl:onProperty cah:hasParticipant ],
        [ a owl:Restriction ;
            owl:onProperty cah:organizedBy ;
            owl:someValuesFrom cah:Curator ],
        crm:E7_Activity .

cah:Institution a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:comment "An organization such as a museum." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artwork ;
            owl:onProperty cah:inverse_heldBy ],
        crm:E40_Legal_Body .

cah:Artist a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:comment "A person who creates artworks." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artwork ;
            owl:onProperty cah:inverse_createdBy ],
        crm:E21_Person ;
    owl:disjointWith cah:Artwork .

cah:Artwork a owl:Class ;
    rdfs:label "Artwork" ;
    rdfs:comment "A cultural or artistic work." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:hasContributor ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:createdBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:createdBy ],
        crm:E22_Man-Made_Object,
        edm:ProvidedCHO ;
    owl:disjointWith cah:Exhibition .

ch:met_museum a ch:Museum ;
    rdfs:label "Metropolitan Museum of Art, New York, NY" .

