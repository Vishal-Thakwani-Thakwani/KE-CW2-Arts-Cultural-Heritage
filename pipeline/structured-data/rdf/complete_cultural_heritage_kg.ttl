@prefix cah: <http://example.org/culturalheritage#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cah:BirthEvent a owl:Class ;
    rdfs:label "BirthEvent" ;
    rdfs:comment "The birth of a person." ;
    rdfs:subClassOf crm:E67_Birth .

cah:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "A subdivision of a country." ;
    rdfs:subClassOf crm:E53_Place .

cah:CollaborativeArtwork a owl:Class ;
    rdfs:subClassOf cah:Artwork ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:hasContributor ] .

cah:CreationEvent a owl:Class ;
    rdfs:label "CreationEvent" ;
    rdfs:comment "The act of creating an artwork." ;
    rdfs:subClassOf crm:E12_Production .

cah:InternationalProvenanceArtwork a owl:Class ;
    rdfs:subClassOf cah:Artwork ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Institution ;
            owl:onProperty cah:hasOwner ] .

cah:Painting a owl:Class ;
    rdfs:label "Painting" ;
    rdfs:comment "A type of artwork created using paint." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cah:usesMedium ;
            owl:someValuesFrom cah:Medium ],
        cah:Artwork .

cah:Sculpture a owl:Class ;
    rdfs:label "Sculpture" ;
    rdfs:comment "A three-dimensional artwork." ;
    rdfs:subClassOf cah:Artwork .

cah:activeInMovement a owl:ObjectProperty ;
    rdfs:label "activeInMovement" ;
    rdfs:comment "Relates an artist to an art movement." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:ArtMovement ;
    owl:propertyChainAxiom ( cah:inverse_createdBy cah:belongsToMovement ) .

cah:awardYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "awardYear" ;
    rdfs:comment "The year a prize was awarded." ;
    rdfs:domain cah:Prize ;
    rdfs:range xsd:gYear .

cah:collaboratedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaboratedWith" ;
    rdfs:comment "Relates artists who collaborated on an artwork." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:createdInPeriod a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "createdInPeriod" ;
    rdfs:comment "Relates an artwork to an art period." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:ArtPeriod .

cah:hasBirthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasBirthDate" ;
    rdfs:comment "The birth date of an artist." ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:date .

cah:hasCountry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasCountry" ;
    rdfs:comment "Relates a place to a country." ;
    rdfs:domain crm:E53_Place ;
    rdfs:range cah:Country .

cah:hasCreationDate a owl:DatatypeProperty ;
    rdfs:label "hasCreationDate" ;
    rdfs:comment "The date when an artwork was created." ;
    rdfs:domain cah:Artwork ;
    rdfs:range xsd:date .

cah:hasGenre a owl:ObjectProperty ;
    rdfs:label "hasGenre" ;
    rdfs:comment "Relates an artwork to a genre." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Genre .

cah:influencedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "influencedBy" ;
    rdfs:comment "Relates an artist to another artist who influenced them." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist ;
    owl:inverseOf cah:inverse_influencedBy .

cah:isLiving a owl:DatatypeProperty ;
    rdfs:label "isLiving" ;
    rdfs:comment "Indicates whether an artist is alive." ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:boolean .

