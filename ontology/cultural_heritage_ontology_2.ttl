@prefix cah: <http://example.org/culturalheritage#> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> . 
@prefix ore: <http://www.openarchives.org/ore/terms/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

########################
# Classes
########################

cah:Artist a owl:Class ;
    rdfs:label "Artist" ;
    rdfs:comment "A person who creates artworks" ;
    rdfs:subClassOf crm:E21_Person .

cah:Artwork a owl:Class ;
    rdfs:label "Artwork" ;
    rdfs:comment "A cultural or artistic work" ;
    rdfs:subClassOf edm:ProvidedCHO , crm:E22_Man-Made_Object .

cah:Museum a owl:Class ;
    rdfs:subClassOf crm:E40_Legal_Body .

cah:Painting a owl:Class ;
    rdfs:subClassOf cah:Artwork .

cah:Sculpture a owl:Class ;
    rdfs:subClassOf cah:Artwork .

cah:ArtMovement a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

cah:ArtPeriod a owl:Class ;
    rdfs:subClassOf crm:E4_Period .

cah:Genre a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

cah:Medium a owl:Class ;
    rdfs:subClassOf crm:E57_Material .

cah:Exhibition a owl:Class ;
    rdfs:subClassOf crm:E7_Activity .

cah:RestorationEvent a owl:Class ;
    rdfs:subClassOf crm:E11_Modification .

cah:CreationEvent a owl:Class ;
    rdfs:subClassOf crm:E12_Production .

cah:BirthEvent a owl:Class ;
    rdfs:subClassOf crm:E67_Birth .

cah:ProvenanceEvent a owl:Class ;
    rdfs:subClassOf crm:E10_Transfer_of_Custody .

cah:DonationEvent a owl:Class ;
    rdfs:subClassOf cah:ProvenanceEvent .

cah:Collector a owl:Class ;
    rdfs:subClassOf crm:E39_Actor .

cah:Curator a owl:Class ;
    rdfs:subClassOf crm:E21_Person .

cah:Institution a owl:Class ;
    rdfs:subClassOf crm:E40_Legal_Body .

cah:Country a owl:Class ;
    rdfs:subClassOf crm:E53_Place .

cah:City a owl:Class ;
    rdfs:subClassOf crm:E53_Place .

cah:TimeSpan a owl:Class ;
    rdfs:subClassOf crm:E52_Time-Span .

cah:Prize a owl:Class ;
    rdfs:subClassOf crm:E89_Propositional_Object .

########################
# Object Properties
########################

cah:createdBy a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Artist ;
    owl:inverseOf cah:inverse_createdBy ;
    rdfs:subPropertyOf crm:P14_carried_out_by .

cah:inverse_createdBy a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artwork .

cah:createdInPeriod a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:ArtPeriod .

cah:activeInMovement a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:ArtMovement .

cah:belongsToMovement a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:ArtMovement .

cah:hasGenre a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Genre .

cah:usesMedium a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Medium .

cah:heldBy a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Institution ;
    owl:inverseOf cah:inverse_heldBy ;
    rdfs:subPropertyOf crm:P50_has_current_keeper .

cah:inverse_heldBy a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:Artwork .

cah:locatedIn a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range crm:E53_Place ;
    rdfs:subPropertyOf crm:P53_has_former_or_current_location .

cah:participatedInExhibition a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Exhibition ;
    owl:inverseOf cah:inverse_participatedInExhibition .

cah:inverse_participatedInExhibition a owl:ObjectProperty ;
    rdfs:domain cah:Exhibition ;
    rdfs:range cah:Artwork .

cah:organizedBy a owl:ObjectProperty ;
    rdfs:domain cah:Exhibition ;
    rdfs:range cah:Curator .

cah:hasParticipant a owl:ObjectProperty ;
    rdfs:domain cah:Exhibition ;
    rdfs:range crm:E39_Actor .

cah:underwentRestoration a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:RestorationEvent ;
    owl:inverseOf cah:inverse_underwentRestoration .

cah:inverse_underwentRestoration a owl:ObjectProperty ;
    rdfs:domain cah:RestorationEvent ;
    rdfs:range cah:Artwork .

cah:hasTimeSpan a owl:ObjectProperty ;
    rdfs:domain crm:E2_Temporal_Entity ;
    rdfs:range cah:TimeSpan ;
    rdfs:subPropertyOf crm:P4_has_time-span .

cah:hasOwner a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Institution .

cah:transferredOwnershipTo a owl:ObjectProperty ;
    rdfs:domain cah:ProvenanceEvent ;
    rdfs:range cah:Institution .

cah:transferredOwnershipFrom a owl:ObjectProperty ;
    rdfs:domain cah:ProvenanceEvent ;
    rdfs:range cah:Institution .

cah:hasCountry a owl:ObjectProperty ;
    rdfs:domain crm:E53_Place ;
    rdfs:range cah:Country .

cah:influencedBy a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist ;
    owl:inverseOf cah:inverse_influencedBy .

cah:inverse_influencedBy a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:collaboratedWith a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:wonPrize a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Prize .

cah:donatedBy a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Collector .

cah:donatedTo a owl:ObjectProperty ;
    rdfs:domain cah:DonationEvent ;
    rdfs:range cah:Museum .

cah:hasContributor a owl:ObjectProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Artist .

########################
# Datatype Properties
########################

cah:hasCreationDate a owl:DatatypeProperty ;
    rdfs:domain cah:Artwork ;
    rdfs:range xsd:date .

cah:hasBirthDate a owl:DatatypeProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:date .

cah:startDate a owl:DatatypeProperty ;
    rdfs:domain cah:TimeSpan ;
    rdfs:range xsd:date .

cah:endDate a owl:DatatypeProperty ;
    rdfs:domain cah:TimeSpan ;
    rdfs:range xsd:date .

cah:awardYear a owl:DatatypeProperty ;
    rdfs:domain cah:Prize ;
    rdfs:range xsd:gYear .

cah:isLiving a owl:DatatypeProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:boolean .

########################
# Axioms / Restrictions
########################

cah:Painting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:usesMedium ;
    owl:someValuesFrom cah:Medium
] .

cah:Artwork rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:createdBy ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Artist
] .

cah:Exhibition rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:organizedBy ;
    owl:someValuesFrom cah:Curator
] .

cah:RestorationEvent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:hasTimeSpan ;
    owl:someValuesFrom cah:TimeSpan
] .


########################
# Enriched Semantic Relations
########################

cah:createdInPeriod a owl:FunctionalProperty , owl:AsymmetricProperty , owl:IrreflexiveProperty .

cah:periodIncludesArtwork a owl:ObjectProperty ;
    rdfs:domain cah:ArtPeriod ;
    rdfs:range cah:Artwork ;
    owl:inverseOf cah:createdInPeriod .

cah:activeInMovement owl:inverseOf cah:hasActiveArtist .

cah:hasActiveArtist a owl:ObjectProperty ;
    rdfs:domain cah:ArtMovement ;
    rdfs:range cah:Artist .

cah:belongsToMovement owl:inverseOf cah:hasArtworkInMovement ;
    owl:propertyChainAxiom ( cah:createdBy cah:activeInMovement ) .

cah:hasArtworkInMovement a owl:ObjectProperty ;
    rdfs:domain cah:ArtMovement ;
    rdfs:range cah:Artwork .

cah:hasGenre owl:inverseOf cah:isGenreOf .

cah:isGenreOf a owl:ObjectProperty ;
    rdfs:domain cah:Genre ;
    rdfs:range cah:Artwork .

cah:usesMedium owl:inverseOf cah:isMediumOf .

cah:isMediumOf a owl:ObjectProperty ;
    rdfs:domain cah:Medium ;
    rdfs:range cah:Artwork .

cah:heldBy a owl:FunctionalProperty .

cah:holdsArtwork a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:Artwork ;
    owl:inverseOf cah:heldBy .

cah:locatedIn a owl:FunctionalProperty .

cah:hostsInstitution a owl:ObjectProperty ;
    rdfs:domain crm:E53_Place ;
    rdfs:range cah:Institution ;
    owl:inverseOf cah:locatedIn .

cah:participatedInExhibition owl:inverseOf cah:exhibitsArtwork .

cah:exhibitsArtwork a owl:ObjectProperty ;
    rdfs:domain cah:Exhibition ;
    rdfs:range cah:Artwork .

cah:organizedBy owl:inverseOf cah:organizesExhibition .

cah:organizesExhibition a owl:ObjectProperty ;
    rdfs:domain cah:Curator ;
    rdfs:range cah:Exhibition .

cah:hasParticipant owl:inverseOf cah:participatesInExhibition .

cah:participatesInExhibition a owl:ObjectProperty ;
    rdfs:domain crm:E39_Actor ;
    rdfs:range cah:Exhibition .

cah:underwentRestoration owl:inverseOf cah:restoresArtwork .

cah:restoresArtwork a owl:FunctionalProperty ;
    rdfs:domain cah:RestorationEvent ;
    rdfs:range cah:Artwork .

cah:hasTimeSpan a owl:FunctionalProperty ;
    owl:inverseOf cah:isTimeSpanOf .

cah:isTimeSpanOf a owl:ObjectProperty ;
    rdfs:domain cah:TimeSpan ;
    rdfs:range crm:E2_Temporal_Entity .

cah:hasOwner a owl:FunctionalProperty ;
    owl:inverseOf cah:ownsArtwork .

cah:ownsArtwork a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:Artwork .

cah:transferredOwnershipTo a owl:FunctionalProperty ;
    owl:inverseOf cah:isTransferredToBy .

cah:isTransferredToBy a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:ProvenanceEvent .

cah:transferredOwnershipFrom a owl:FunctionalProperty ;
    owl:inverseOf cah:isTransferredFromBy .

cah:isTransferredFromBy a owl:ObjectProperty ;
    rdfs:domain cah:Institution ;
    rdfs:range cah:ProvenanceEvent .

cah:hasCountry a owl:FunctionalProperty ;
    owl:inverseOf cah:containsPlace .

cah:containsPlace a owl:ObjectProperty ;
    rdfs:domain cah:Country ;
    rdfs:range crm:E53_Place .

cah:influencedBy a owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    owl:inverseOf cah:influences .

cah:influences a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:collaboratedWith a owl:SymmetricProperty , owl:IrreflexiveProperty .

cah:wonPrize owl:inverseOf cah:awardedTo .

cah:awardedTo a owl:ObjectProperty ;
    rdfs:domain cah:Prize ;
    rdfs:range cah:Artist .

cah:donatedBy a owl:FunctionalProperty ;
    owl:inverseOf cah:donatedArtwork .

cah:donatedArtwork a owl:ObjectProperty ;
    rdfs:domain cah:Collector ;
    rdfs:range cah:Artwork .

cah:donatedTo a owl:FunctionalProperty ;
    owl:inverseOf cah:receivedDonation .

cah:receivedDonation a owl:ObjectProperty ;
    rdfs:domain cah:Museum ;
    rdfs:range cah:DonationEvent .

cah:hasContributor owl:inverseOf cah:contributedToArtwork .

cah:contributedToArtwork a owl:ObjectProperty ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artwork .

cah:hasCreationDate a owl:FunctionalProperty .

cah:hasBirthDate a owl:FunctionalProperty .

cah:startDate a owl:FunctionalProperty .

cah:endDate a owl:FunctionalProperty .

cah:awardYear a owl:FunctionalProperty .

cah:isLiving a owl:FunctionalProperty .

cah:Artwork rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:createdInPeriod ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:ArtPeriod
] , [
    a owl:Restriction ;
    owl:onProperty cah:hasGenre ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Genre
] , [
    a owl:Restriction ;
    owl:onProperty cah:usesMedium ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Medium
] , [
    a owl:Restriction ;
    owl:onProperty cah:heldBy ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Institution
] , [
    a owl:Restriction ;
    owl:onProperty cah:hasOwner ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Institution
] .

cah:Artist rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:activeInMovement ;
    owl:someValuesFrom cah:ArtMovement
] , [
    a owl:Restriction ;
    owl:onProperty cah:hasBirthDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date
] , [
    a owl:Restriction ;
    owl:onProperty cah:isLiving ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:boolean
] .

cah:Exhibition rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:organizedBy ;
    owl:someValuesFrom cah:Curator
] , [
    a owl:Restriction ;
    owl:onProperty cah:hasParticipant ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass crm:E39_Actor
] .

cah:RestorationEvent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:restoresArtwork ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Artwork
] .

cah:ProvenanceEvent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:transferredOwnershipFrom ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Institution
] , [
    a owl:Restriction ;
    owl:onProperty cah:transferredOwnershipTo ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Institution
] .

cah:DonationEvent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:donatedTo ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Museum
] .

cah:Institution rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:locatedIn ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass crm:E53_Place
] .

cah:City rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:hasCountry ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass cah:Country
] .

cah:Prize rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:awardYear ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:gYear
] .

cah:TimeSpan rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cah:startDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date
] , [
    a owl:Restriction ;
    owl:onProperty cah:endDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date
] .
