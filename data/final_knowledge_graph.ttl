cah:Medium a owl:Class ;
    rdfs:label "Medium" ;
    rdfs:comment "The material or technique used in an artwork." ;
    rdfs:subClassOf crm:E57_Material .

cah:Artwork a owl:Class ;
    rdfs:label "Artwork" ;
    rdfs:comment "A cultural or artistic work." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:hasContributor ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:createdBy ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cah:Artist ;
            owl:onProperty cah:createdBy ],
        crm:E22_Man-Made_Object,
        edm:ProvidedCHO ;
    owl:disjointWith cah:Exhibition .

