cah:activeInMovement a owl:ObjectProperty ;
    rdfs:label "activeInMovement" ;
    rdfs:comment "Relates an artist to an art movement." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:ArtMovement ;
    owl:propertyChainAxiom ( cah:inverse_createdBy cah:belongsToMovement ) .

cah:awardYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "awardYear" ;
    rdfs:comment "The year a prize was awarded." ;
    rdfs:domain cah:Prize ;
    rdfs:range xsd:gYear .

cah:collaboratedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaboratedWith" ;
    rdfs:comment "Relates artists who collaborated on an artwork." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist .

cah:createdInPeriod a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "createdInPeriod" ;
    rdfs:comment "Relates an artwork to an art period." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:ArtPeriod .

cah:hasBirthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasBirthDate" ;
    rdfs:comment "The birth date of an artist." ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:date .

cah:hasCountry a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "hasCountry" ;
    rdfs:comment "Relates a place to a country." ;
    rdfs:domain crm:E53_Place ;
    rdfs:range cah:Country .

cah:hasCreationDate a owl:DatatypeProperty ;
    rdfs:label "hasCreationDate" ;
    rdfs:comment "The date when an artwork was created." ;
    rdfs:domain cah:Artwork ;
    rdfs:range xsd:date .

cah:hasGenre a owl:ObjectProperty ;
    rdfs:label "hasGenre" ;
    rdfs:comment "Relates an artwork to a genre." ;
    rdfs:domain cah:Artwork ;
    rdfs:range cah:Genre .

cah:influencedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "influencedBy" ;
    rdfs:comment "Relates an artist to another artist who influenced them." ;
    rdfs:domain cah:Artist ;
    rdfs:range cah:Artist ;
    owl:inverseOf cah:inverse_influencedBy .

cah:isLiving a owl:DatatypeProperty ;
    rdfs:label "isLiving" ;
    rdfs:comment "Indicates whether an artist is alive." ;
    rdfs:domain cah:Artist ;
    rdfs:range xsd:boolean .

